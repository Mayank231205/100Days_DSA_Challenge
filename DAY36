#include <stdio.h>

#define MAX 100

int queue[MAX];
int front = -1;
int rear = -1;
int size;

void enqueue(int value)
{
    if ((rear + 1) % size == front)
        return;

    if (front == -1)
    {
        front = 0;
        rear = 0;
    }
    else
    {
        rear = (rear + 1) % size;
    }

    queue[rear] = value;
}

void dequeue()
{
    if (front == -1)
        return;

    if (front == rear)
    {
        front = -1;
        rear = -1;
    }
    else
    {
        front = (front + 1) % size;
    }
}

void display()
{
    int i;

    if (front == -1)
        return;

    i = front;

    while (1)
    {
        printf("%d ", queue[i]);

        if (i == rear)
            break;

        i = (i + 1) % size;
    }
}

int main()
{
    int n, m, i, x;

    scanf("%d", &n);
    size = n;

    for (i = 0; i < n; i++)
    {
        scanf("%d", &x);
        enqueue(x);
    }

    scanf("%d", &m);

    for (i = 0; i < m; i++)
    {
        dequeue();
    }

    display();

    return 0;
}
