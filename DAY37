#include <stdio.h>
#include <string.h>

#define MAX 100

int pq[MAX];
int size = 0;

// Insert element
void insert(int x)
{
    if(size == MAX)
    {
        printf("Queue Full\n");
        return;
    }

    pq[size++] = x;

    // Sort so smaller value = higher priority
    for(int i = 0; i < size-1; i++)
    {
        for(int j = i+1; j < size; j++)
        {
            if(pq[i] > pq[j])
            {
                int temp = pq[i];
                pq[i] = pq[j];
                pq[j] = temp;
            }
        }
    }
}

// Delete element
int deleteElement()
{
    if(size == 0)
        return -1;

    int val = pq[0];

    for(int i = 1; i < size; i++)
        pq[i-1] = pq[i];

    size--;

    return val;
}

// Peek element
int peek()
{
    if(size == 0)
        return -1;

    return pq[0];
}

int main()
{
    int N, x;
    char op[20];

    printf("Enter number of operations: ");
    scanf("%d",&N);

    for(int i = 0; i < N; i++)
    {
        printf("Enter operation (insert/delete/peek): ");
        scanf("%s",op);

        if(strcmp(op,"insert") == 0)
        {
            scanf("%d",&x);
            insert(x);
        }
        else if(strcmp(op,"delete") == 0)
        {
            printf("%d\n",deleteElement());
        }
        else if(strcmp(op,"peek") == 0)
        {
            printf("%d\n",peek());
        }
    }

    return 0;
}
