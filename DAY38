#include <stdio.h>
#include <string.h>

#define MAX 100

int deque[MAX];
int front = -1;
int rear = -1;

// check empty
int empty() {
    if(front == -1)
        return 1;
    return 0;
}

// size
int size() {
    if(front == -1)
        return 0;
    return rear - front + 1;
}

// push front
void push_front(int x) {
    if(front == -1) {
        front = rear = 0;
        deque[front] = x;
    }
    else if(front > 0) {
        front--;
        deque[front] = x;
    }
    else {
        printf("Deque Full\n");
    }
}

// push back
void push_back(int x) {
    if(front == -1) {
        front = rear = 0;
        deque[rear] = x;
    }
    else if(rear < MAX-1) {
        rear++;
        deque[rear] = x;
    }
    else {
        printf("Deque Full\n");
    }
}

// pop front
int pop_front() {
    if(empty())
        return -1;

    int val = deque[front];

    if(front == rear)
        front = rear = -1;
    else
        front++;

    return val;
}

// pop back
int pop_back() {
    if(empty())
        return -1;

    int val = deque[rear];

    if(front == rear)
        front = rear = -1;
    else
        rear--;

    return val;
}

// front element
int frontElement() {
    if(empty())
        return -1;
    return deque[front];
}

// back element
int backElement() {
    if(empty())
        return -1;
    return deque[rear];
}

int main() {

    int n, x;
    char op[20];

    printf("Enter number of operations: ");
    scanf("%d",&n);

    for(int i=0;i<n;i++) {

        scanf("%s",op);

        if(strcmp(op,"push_front")==0) {
            scanf("%d",&x);
            push_front(x);
        }

        else if(strcmp(op,"push_back")==0) {
            scanf("%d",&x);
            push_back(x);
        }

        else if(strcmp(op,"pop_front")==0) {
            printf("%d\n",pop_front());
        }

        else if(strcmp(op,"pop_back")==0) {
            printf("%d\n",pop_back());
        }

        else if(strcmp(op,"front")==0) {
            printf("%d\n",frontElement());
        }

        else if(strcmp(op,"back")==0) {
            printf("%d\n",backElement());
        }

        else if(strcmp(op,"size")==0) {
            printf("%d\n",size());
        }

        else if(strcmp(op,"empty")==0) {
            printf("%d\n",empty());
        }
    }

    return 0;
}
