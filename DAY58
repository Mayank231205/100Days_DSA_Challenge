#include <stdio.h>
#include <stdlib.h>

// Node structure
struct Node {
    int data;
    struct Node* left;
    struct Node* right;
};

// Create new node
struct Node* newNode(int data) {
    struct Node* node = (struct Node*)malloc(sizeof(struct Node));
    node->data = data;
    node->left = NULL;
    node->right = NULL;
    return node;
}

// Global index for preorder
int preIndex = 0;

// Find index in inorder
int search(int inorder[], int start, int end, int value) {
    for (int i = start; i <= end; i++) {
        if (inorder[i] == value)
            return i;
    }
    return -1;
}

// Build tree
struct Node* buildTree(int preorder[], int inorder[], int start, int end) {
    if (start > end)
        return NULL;

    // Pick current root from preorder
    struct Node* root = newNode(preorder[preIndex++]);

    // If only one node
    if (start == end)
        return root;

    // Find root in inorder
    int inIndex = search(inorder, start, end, root->data);

    // Build left and right subtree
    root->left = buildTree(preorder, inorder, start, inIndex - 1);
    root->right = buildTree(preorder, inorder, inIndex + 1, end);

    return root;
}

// Postorder traversal
void postorder(struct Node* root) {
    if (root == NULL)
        return;

    postorder(root->left);
    postorder(root->right);
    printf("%d ", root->data);
}

// Main function
int main() {
    int n;
    int preorder[1000], inorder[1000];

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter preorder: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &preorder[i]);
    }

    printf("Enter inorder: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &inorder[i]);
    }

    // Reset index
    preIndex = 0;

    struct Node* root = buildTree(preorder, inorder, 0, n - 1);

    printf("Postorder: ");
    postorder(root);

    printf("\n");

    getchar();
    getchar();

    return 0;
}
