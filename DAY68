#include <stdio.h>

#define MAX 100

int graph[MAX][MAX];
int indegree[MAX];
int queue[MAX];

int main() {
    int n, e;

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter number of edges: ");
    scanf("%d", &e);

    // initialize
    for (int i = 0; i < n; i++) {
        indegree[i] = 0;
        for (int j = 0; j < n; j++) {
            graph[i][j] = 0;
        }
    }

    printf("Enter edges (u v):\n");
    for (int i = 0; i < e; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        graph[u][v] = 1;
        indegree[v]++;
    }

    int front = 0, rear = -1;

    // push nodes with indegree 0
    for (int i = 0; i < n; i++) {
        if (indegree[i] == 0) {
            rear++;
            queue[rear] = i;
        }
    }

    printf("Topological Order: ");

    while (front <= rear) {
        int node = queue[front];
        front++;

        printf("%d ", node);

        for (int i = 0; i < n; i++) {
            if (graph[node][i] == 1) {
                indegree[i]--;

                if (indegree[i] == 0) {
                    rear++;
                    queue[rear] = i;
                }
            }
        }
    }

    return 0;
}
