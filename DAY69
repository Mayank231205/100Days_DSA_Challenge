#include <stdio.h>

#define MAX 100
#define INF 99999

int graph[MAX][MAX];
int dist[MAX];
int visited[MAX];

int main() {
    int n, e, src;

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter number of edges: ");
    scanf("%d", &e);

    // initialize
    for (int i = 0; i < n; i++) {
        dist[i] = INF;
        visited[i] = 0;
        for (int j = 0; j < n; j++) {
            graph[i][j] = 0;
        }
    }

    printf("Enter edges (u v weight):\n");
    for (int i = 0; i < e; i++) {
        int u, v, w;
        scanf("%d %d %d", &u, &v, &w);
        graph[u][v] = w;
    }

    printf("Enter source node: ");
    scanf("%d", &src);

    dist[src] = 0;

    // Dijkstra
    for (int count = 0; count < n - 1; count++) {

        int min = INF, u;

        // find minimum distance node
        for (int i = 0; i < n; i++) {
            if (visited[i] == 0 && dist[i] < min) {
                min = dist[i];
                u = i;
            }
        }

        visited[u] = 1;

        // update neighbors
        for (int v = 0; v < n; v++) {
            if (!visited[v] && graph[u][v] != 0 &&
                dist[u] + graph[u][v] < dist[v]) {

                dist[v] = dist[u] + graph[u][v];
            }
        }
    }

    printf("Shortest distances from source:\n");
    for (int i = 0; i < n; i++) {
        printf("To %d = %d\n", i, dist[i]);
    }

    return 0;
}
